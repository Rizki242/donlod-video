{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://GANTI-DENGAN-URL-BACKEND/api/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
