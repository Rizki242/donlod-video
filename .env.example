# Semua pengaturan opsional. Salin ke .env.local lalu sesuaikan.
# Aplikasi TIDAK memakai LLM / API AI pihak ketiga — tidak perlu API key.

# PORT=3000

# --- VPN / Proxy -----------------------------------------------------------
# Jika VPN aktif di mesin ini (system-wide), tidak perlu diisi: yt-dlp otomatis lewat VPN.
# Isi bila VPN menyediakan proxy lokal (SOCKS5/HTTP). Bisa juga diisi per-pengguna dari UI.
# PROXY_URL="socks5://127.0.0.1:1080"
# Izinkan URL ke IP privat/intranet (situs yang hanya bisa dibuka lewat VPN kantor/kampus).
# Aktifkan HANYA bila server dipakai pribadi / di jaringan tepercaya.
# ALLOW_PRIVATE_URLS=true
# File cookies format Netscape untuk situs yang butuh login (ekspor dari browser).
# YTDLP_COOKIES_FILE="./cookies.txt"

# --- Binary ---------------------------------------------------------------
# yt-dlp diunduh otomatis ke ./bin; ffmpeg dari paket ffmpeg-static.
# YTDLP_PATH="/usr/local/bin/yt-dlp"
# FFMPEG_PATH="/usr/bin/ffmpeg"

# --- Speech-to-text lokal (Whisper) -----------------------------------------
# Model diunduh sekali ke MODELS_DIR. Pilihan (makin besar makin akurat, makin lambat):
#   onnx-community/whisper-base   (~150 MB, cepat)
#   onnx-community/whisper-small  (~450 MB, default, seimbang)
#   onnx-community/whisper-large-v3-turbo (~1.6 GB, paling akurat)
# WHISPER_MODEL="onnx-community/whisper-small"
# MODELS_DIR="./models"
# Set true setelah model terunduh untuk mode offline penuh.
# WHISPER_OFFLINE=false
# WHISPER_PRELOAD=true
# WHISPER_ENCODER_DTYPE=fp32
# WHISPER_DECODER_DTYPE=q8

# --- Job & batas ------------------------------------------------------------
# WORK_DIR="/tmp/videoscribe"
# JOB_TTL_MINUTES=60
# MAX_CONCURRENT_JOBS=3
# MAX_UPLOAD_MB=2048
# MAX_DURATION_MINUTES=180
# TRANSCRIBE_CHUNK_SECONDS=300
